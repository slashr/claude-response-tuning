#!/usr/bin/python3
"""response-rewrite -- route a completed Claude draft through OpenAI Luna.

Reads Claude's finished draft on stdin (or from a file argument) and writes a
bright visual marker followed by the Luna-edited version to stdout.

The contract is fail-safe: once the draft has been read, this script ALWAYS
writes a usable answer to stdout and ALWAYS exits 0. Missing API key, timeout,
HTTP error, truncated or malformed response, empty output, or a rewrite that
dropped a protected literal all fall back to Claude's original draft, with the
reason recorded on stderr.

The single exception is a draft that could not be read at all (unreadable file
argument or unreadable stdin). There is no text to protect in that case, so the
script exits 2 rather than reporting success it did not achieve.

Usage:
    response-rewrite < draft.md
    response-rewrite draft.md
    response-rewrite --check        # print resolved config, make no API call

Environment:
    CLAUDE_REWRITE_OPENAI_KEY   required; also read from ~/.claude/response-rewrite.env
                                or an `export` line in ~/.zshrc
    CLAUDE_REWRITE_MODEL        default gpt-5.6-luna
    CLAUDE_REWRITE_EFFORT       default low  (the Luna-light setting)
    CLAUDE_REWRITE_VERBOSITY    default low  (Responses API text verbosity)
    CLAUDE_REWRITE_TIMEOUT      default 60   (seconds)
    CLAUDE_REWRITE_API_URL      default https://api.openai.com/v1/responses
    CLAUDE_REWRITE_MIN_RATIO    default 0.2  (truncation floor, rewrite/draft chars)
    CLAUDE_REWRITE_PROMPT       optional prompt file; defaults to
                                ~/.claude/prompts/response-rewrite.md
"""

from __future__ import annotations

import json
import os
import re
import socket
import sys
import urllib.error
import urllib.request

KEY_VAR = "CLAUDE_REWRITE_OPENAI_KEY"
PROMPT_VAR = "CLAUDE_REWRITE_PROMPT"
DEFAULT_MODEL = "gpt-5.6-luna"
DEFAULT_EFFORT = "low"
DEFAULT_VERBOSITY = "low"
DEFAULT_TIMEOUT = 60.0
DEFAULT_API_URL = "https://api.openai.com/v1/responses"
DEFAULT_MIN_RATIO = 0.2
RATIO_FLOOR_MIN_DRAFT = 400
MAX_LITERALS = 4000
ANSWER_SEPARATOR = "🟨" * 20 + "\n\n"
DEFAULT_PROMPT_RELATIVE = os.path.join("prompts", "response-rewrite.md")


# Held at module scope so the last-resort handler can still emit the draft
# after an exception unwinds main(). _EMITTED stops it writing a second copy on
# top of a partial write.
_DRAFT = ""
_EMITTED = False


def note(reason: str) -> None:
    # Best-effort: a closed or broken stderr must never cost the response.
    try:
        sys.stderr.write("response-rewrite: %s\n" % reason)
    except Exception:
        pass


def emit(text: str) -> None:
    global _EMITTED
    _EMITTED = True
    if text:
        sys.stdout.write(ANSWER_SEPARATOR)
    sys.stdout.write(text)
    if text and not text.endswith("\n"):
        sys.stdout.write("\n")


def fall_back(draft: str, reason: str) -> None:
    """Print Claude's original draft and explain why. Never raises."""
    note("falling back to draft (%s)" % reason)
    emit(draft)
    sys.exit(0)


# --------------------------------------------------------------------------
# Key resolution. The key value is never logged, echoed, or written anywhere.
# --------------------------------------------------------------------------

def resolve_key() -> str:
    key = (os.environ.get(KEY_VAR) or "").strip()
    if key:
        return key

    env_file = os.path.expanduser("~/.claude/response-rewrite.env")
    key = _key_from_file(env_file, r"^\s*(?:export\s+)?%s\s*=\s*(.+?)\s*$")
    if key:
        return key

    # Claude Code tool shells do not always inherit an interactive profile, so
    # fall back to the canonical `export` line in the user's own shell config.
    return _key_from_file(
        os.path.expanduser("~/.zshrc"),
        r"^\s*export\s+%s\s*=\s*(.+?)\s*$",
    )


def _key_from_file(path: str, pattern_template: str) -> str:
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as handle:
            contents = handle.read()
    except OSError:
        return ""
    match = re.search(
        pattern_template % re.escape(KEY_VAR), contents, re.MULTILINE
    )
    if not match:
        return ""
    value = match.group(1).strip()
    if value[:1] in ("'", '"') and value[-1:] == value[:1] and len(value) > 1:
        value = value[1:-1]
    return value.strip()


# --------------------------------------------------------------------------
# Prompt resolution. The prompt is intentionally optional: if the configured
# file is missing or empty, the request omits `instructions` and Luna uses its
# own default behavior. There is no embedded prompt fallback to maintain.
# --------------------------------------------------------------------------

def default_prompt_path() -> str:
    return os.path.abspath(
        os.path.join(os.path.dirname(__file__), os.pardir, DEFAULT_PROMPT_RELATIVE)
    )


def resolve_prompt():
    configured = (os.environ.get(PROMPT_VAR) or "").strip()
    path = os.path.expanduser(configured or default_prompt_path())
    try:
        with open(path, "r", encoding="utf-8") as handle:
            prompt = handle.read()
    except (OSError, UnicodeError):
        return None, path, "missing"
    if not prompt.strip():
        return None, path, "empty"
    return prompt, path, "resolved"


# --------------------------------------------------------------------------
# Protected literals: anything Luna must carry through untouched.
# --------------------------------------------------------------------------

FENCE_RE = re.compile(r"(?ms)^[ \t]*(`{3,}|~{3,})[^\n]*\n(.*?)^[ \t]*\1")
INLINE_CODE_RE = re.compile(r"`([^`\n]+)`")
TABLE_ROW_RE = re.compile(r"^\s*\|.*\|\s*$")
URL_RE = re.compile(r"https?://[^\s)\]}>\"'`]+")
PATH_ROOTS = (
    "Users|private|tmp|var|etc|opt|usr|home|Volumes|Applications|Library|"
    "System|workspace|mnt|root|dev|bin|sbin|v1|api|src|dist|build|scripts|"
    "docs|test|tests|app|node_modules"
)
PATH_RE = re.compile(
    r"(?<![\w])(?:~/[\w.\-/@+]+|/(?:%s)(?:/[\w.\-/@+]*)*)(?![\w])"
    % PATH_ROOTS
)
NUMBER_RE = re.compile(r"\d+(?:[.,]\d+)*")
SEPARATOR_CELL_RE = re.compile(r"^:?-{2,}:?$")


def protected_literals(draft: str):
    """Return [(kind, literal)] that must survive the rewrite, deduped."""
    seen = set()
    out = []

    def add(kind: str, literal: str) -> None:
        literal = literal.strip()
        if len(literal) < 2 or literal in seen:
            return
        seen.add(literal)
        out.append((kind, literal))

    # Code blocks: require each non-blank line, so pure re-indentation or a
    # changed trailing newline does not trip the check but edited code does.
    fenced_spans = []
    for match in FENCE_RE.finditer(draft):
        fenced_spans.append(match.span())
        for line in match.group(2).splitlines():
            add("code block line", line)

    def inside_fence(pos: int) -> bool:
        return any(start <= pos < end for start, end in fenced_spans)

    for match in INLINE_CODE_RE.finditer(draft):
        if not inside_fence(match.start()):
            add("inline code", match.group(1))

    table_rows = 0
    for line in draft.splitlines():
        if not TABLE_ROW_RE.match(line):
            continue
        table_rows += 1
        for cell in line.strip().strip("|").split("|"):
            cell = cell.strip()
            if cell and not SEPARATOR_CELL_RE.match(cell):
                add("table cell", cell)

    for match in URL_RE.finditer(draft):
        add("url", match.group(0).rstrip(".,;:"))
    for match in PATH_RE.finditer(draft):
        add("path", match.group(0).rstrip(".,;:"))
    for match in NUMBER_RE.finditer(draft):
        add("number", match.group(0))

    return out[:MAX_LITERALS], table_rows


def verify(draft: str, rewrite: str):
    """Return None if the rewrite kept everything protected, else a reason."""
    literals, draft_rows = protected_literals(draft)

    missing = [(kind, lit) for kind, lit in literals if lit not in rewrite]
    if missing:
        shown = ", ".join(
            "%s %r" % (kind, lit[:60]) for kind, lit in missing[:3]
        )
        more = "" if len(missing) <= 3 else " (+%d more)" % (len(missing) - 3)
        return "dropped %d protected literal(s): %s%s" % (
            len(missing),
            shown,
            more,
        )

    rewrite_rows = sum(
        1 for line in rewrite.splitlines() if TABLE_ROW_RE.match(line)
    )
    if rewrite_rows < draft_rows:
        return "table shrank: %d rows in draft, %d in rewrite" % (
            draft_rows,
            rewrite_rows,
        )

    # The length floor catches a truncated API response, but only on drafts long
    # enough for a big cut to be suspicious. On a short draft, honest tightening
    # is proportionally huge (a padded 213-char draft legitimately edits down to
    # 52), so there the protected literals above are the real guard.
    draft_len = len(draft.strip())
    min_ratio = _float_env("CLAUDE_REWRITE_MIN_RATIO", DEFAULT_MIN_RATIO)
    if draft_len >= RATIO_FLOOR_MIN_DRAFT:
        if len(rewrite.strip()) < draft_len * min_ratio:
            return "rewrite looks truncated: %d chars vs %d in draft" % (
                len(rewrite.strip()),
                draft_len,
            )
    return None


def _float_env(name: str, default: float) -> float:
    try:
        return float(os.environ[name])
    except (KeyError, ValueError):
        return default


# --------------------------------------------------------------------------
# Luna call
# --------------------------------------------------------------------------

def call_luna(draft: str, key: str, instructions=None):
    """Return (text, None) on success or (None, reason) on failure."""
    payload = {
        "model": os.environ.get("CLAUDE_REWRITE_MODEL") or DEFAULT_MODEL,
        "reasoning": {
            "effort": os.environ.get("CLAUDE_REWRITE_EFFORT") or DEFAULT_EFFORT
        },
        "store": False,
        # Must stay nested; a top-level "verbosity" key is rejected outright.
        "text": {
            "verbosity": (
                os.environ.get("CLAUDE_REWRITE_VERBOSITY") or DEFAULT_VERBOSITY
            )
        },
        "input": draft,
    }
    if instructions:
        payload["instructions"] = instructions
    timeout = _float_env("CLAUDE_REWRITE_TIMEOUT", DEFAULT_TIMEOUT)
    try:
        # Built inside the guard: an unusable CLAUDE_REWRITE_API_URL or an
        # unencodable payload must fall back like any other request failure.
        request = urllib.request.Request(
            os.environ.get("CLAUDE_REWRITE_API_URL") or DEFAULT_API_URL,
            data=json.dumps(payload).encode("utf-8"),
            headers={
                "Authorization": "Bearer %s" % key,
                "Content-Type": "application/json",
            },
            method="POST",
        )
        with urllib.request.urlopen(request, timeout=timeout) as response:
            body = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        return None, "HTTP %s: %s" % (exc.code, _http_detail(exc))
    except urllib.error.URLError as exc:
        if isinstance(exc.reason, (socket.timeout, TimeoutError)):
            return None, "timed out after %gs" % timeout
        return None, "network error: %s" % (exc.reason,)
    except (socket.timeout, TimeoutError):
        return None, "timed out after %gs" % timeout
    except Exception as exc:
        # Deliberately broad: http.client.IncompleteRead and its HTTPException
        # siblings are neither OSError nor ValueError, so a narrower clause lets
        # a mid-body truncation reach the module-level handler, which exits
        # without emitting the draft. Returning a reason keeps the fallback.
        return None, "request failed: %r" % (exc,)

    if not isinstance(body, dict):
        return None, "unexpected response shape: %s" % type(body).__name__

    status = body.get("status")
    if status and status != "completed":
        details = body.get("incomplete_details")
        detail = details.get("reason") if isinstance(details, dict) else None
        return None, "response not completed (%s)" % (detail or status)

    text = extract_text(body)
    if not text.strip():
        return None, "empty model output"
    return text, None


def _http_detail(exc: urllib.error.HTTPError) -> str:
    try:
        body = json.loads(exc.read().decode("utf-8"))
        message = (body.get("error") or {}).get("message")
        if message:
            return str(message)[:300]
    except Exception:
        pass
    return exc.reason or "no detail"


def extract_text(body) -> str:
    """Collect output_text parts from a Responses API payload.

    Every level is shape-checked rather than trusted: a payload that does not
    match the documented schema must yield "", which call_luna reports as empty
    output, not an exception that escapes to the last-resort handler.
    """
    if not isinstance(body, dict):
        return ""
    if isinstance(body.get("output_text"), str):
        return body["output_text"]
    parts = []
    output = body.get("output")
    for item in output if isinstance(output, list) else []:
        if not isinstance(item, dict) or item.get("type") == "reasoning":
            continue
        content = item.get("content")
        for part in content if isinstance(content, list) else []:
            if isinstance(part, dict) and part.get("type") == "output_text":
                text = part.get("text")
                if isinstance(text, str):
                    parts.append(text)
    return "".join(parts)


WRAPPER_INFO = ("", "markdown", "md", "text", "txt", "plaintext")


def unwrap_fence(draft: str, rewrite: str) -> str:
    """Undo a model wrapping the whole answer in one code fence."""
    if draft.lstrip().startswith(("```", "~~~")):
        return rewrite  # the draft really is a code block
    match = re.match(
        r"(?s)^(`{3,}|~{3,})([^\n]*)\n(.*?)\n?\1\s*$", rewrite.strip()
    )
    if not match:
        return rewrite
    info = match.group(2).strip().lower()
    inner = match.group(3)
    if info in WRAPPER_INFO:
        return inner
    # A real language tag on an answer with no inner fence is plausibly a
    # genuine all-code answer, so leave it alone.
    return rewrite if FENCE_RE.search(inner) else inner


# --------------------------------------------------------------------------

def main() -> None:
    args = [a for a in sys.argv[1:] if a]

    if "--check" in args:
        key = resolve_key()
        _, prompt_path, prompt_status = resolve_prompt()
        print("model:     %s" % (os.environ.get("CLAUDE_REWRITE_MODEL") or DEFAULT_MODEL))
        print("effort:    %s" % (os.environ.get("CLAUDE_REWRITE_EFFORT") or DEFAULT_EFFORT))
        print("verbosity: %s" % (os.environ.get("CLAUDE_REWRITE_VERBOSITY") or DEFAULT_VERBOSITY))
        print("endpoint:  %s" % (os.environ.get("CLAUDE_REWRITE_API_URL") or DEFAULT_API_URL))
        print("timeout:   %gs" % _float_env("CLAUDE_REWRITE_TIMEOUT", DEFAULT_TIMEOUT))
        print("api key:   %s" % ("resolved" if key else "MISSING"))
        print("prompt:    %s" % prompt_status)
        print("prompt path: %s" % prompt_path)
        sys.exit(0)

    # A draft that cannot be read is the one failure exit 0 must not cover: there
    # is no text to protect, and a silent success would hide the lost input.
    if args and not args[0].startswith("-"):
        try:
            with open(args[0], "r", encoding="utf-8") as handle:
                draft = handle.read()
        except (OSError, UnicodeError) as exc:
            note("cannot read draft file: %s" % exc)
            sys.exit(2)
    else:
        try:
            draft = sys.stdin.read()
        except (OSError, UnicodeError) as exc:
            note("cannot read draft from stdin: %s" % exc)
            sys.exit(2)

    global _DRAFT
    _DRAFT = draft

    if not draft.strip():
        note("empty draft, nothing to rewrite")
        emit(draft)
        sys.exit(0)

    key = resolve_key()
    if not key:
        fall_back(draft, "%s not set" % KEY_VAR)

    instructions, prompt_path, prompt_status = resolve_prompt()
    if prompt_status != "resolved":
        note("prompt %s at %s; sending request without instructions" % (
            prompt_status,
            prompt_path,
        ))

    rewrite, reason = call_luna(draft, key, instructions)
    if reason:
        fall_back(draft, reason)

    rewrite = unwrap_fence(draft, rewrite)
    if not rewrite.strip():
        # unwrap_fence can empty a result that was nothing but a fence, and on a
        # short draft verify() passes on literals alone without noticing.
        fall_back(draft, "rewrite is empty after unwrapping")
    reason = verify(draft, rewrite)
    if reason:
        fall_back(draft, reason)

    note("rewrote %d chars -> %d chars" % (len(draft), len(rewrite)))
    emit(rewrite)


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except BaseException as exc:  # never break the response
        note("unexpected error: %r" % (exc,))
        if _DRAFT and not _EMITTED:
            try:
                emit(_DRAFT)
            except Exception:
                pass
        sys.exit(0)
